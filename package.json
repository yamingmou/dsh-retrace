{
  "name": "dsh-retrace",
  "description": "Retrace · 回溯 — Recall, edit-and-resend, regenerate, and conversation/artifact versioning (timeline, rollback, fork graph) for DeepSeek Harness — Web and Desktop",
  "version": "0.4.148",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "build": "node scripts/generate-dynamic.mjs && node scripts/build-client.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-dynamic.mjs && node scripts/check-compat-matrix.mjs && node scripts/check-host-contract.mjs && node scripts/check-publish-scan.mjs",
    "test": "vitest run",
    "prepublishOnly": "node scripts/check-pkg-meta.mjs && npm run build",
    "check:history": "node scripts/check-history-public.mjs --repo . --range origin/main..HEAD",
    "check:history:self": "node scripts/check-history-public.mjs --selfcheck"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.bundle.js"
    },
    "./host-core": {
      "default": "./lib/host-core.js"
    },
    "./dynamic-client": {
      "default": "./lib/dynamic-client.js"
    },
    "./dynamic-host": {
      "default": "./lib/dynamic-host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "HUMANS.txt",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "retrace",
    "timeline",
    "version",
    "artifact",
    "rollback",
    "message",
    "recall",
    "edit",
    "resend",
    "regenerate",
    "conversation",
    "undo"
  ],
  "author": "OfferKuai <contact@offerkuai.com> (https://www.offerkuai.com)",
  "license": "MIT",
  "dshDesktopPatch": {
    "basedOn": {
      "package": "dsh-retrace (upstream base)",
      "version": "0.4.138"
    },
    "target": {
      "package": "dsh-retrace",
      "version": "0.4.148",
      "host": ">=0.1.5 <0.3.0"
    },
    "changes": [
      "http: require a loopback socket peer plus a same-origin Host/Origin gate; non-loopback peer, forged Host or bad Origin => 403 fail-closed",
      "http: the prewrite guard is host-only (the client header can neither enable nor disable it)",
      "http: the fold endpoint requires a raw safe-integer range (400 on invalid) and strips a caller-supplied span",
      "client-config: retention bounds unified (5..500) between the store clamp and the number-input markup",
      "client-config: multi-tab sync (read-merge before write, refresh after write, storage listener)",
      "compat: the matrix gate covers non-@deepseek-ai/dsh* dependencies with explicit WARN/FAIL (no silent skip)"
    ],
    "notes": "Metadata only. Human-readable per-change notes and the fill-in template live in docs/PATCH-NOTES.md."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5 <0.3.0",
      "node": ">=20.0.0",
      "modes": [
        "desktop",
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.7-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "dsh-log-contract": "^0.3.18",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamingmou/dsh-retrace.git"
  },
  "bugs": {
    "url": "https://github.com/yamingmou/dsh-retrace/issues"
  },
  "homepage": "https://github.com/yamingmou/dsh-retrace#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  },
  "bin": {
    "retrace": "bin/retrace.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
